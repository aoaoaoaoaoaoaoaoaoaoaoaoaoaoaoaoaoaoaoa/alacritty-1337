<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
   <Package Name="alacritty-1337" UpgradeCode="2e7e3716-b068-4498-9aa3-eea98bd3204c" Language="1033" Codepage="1252" Version="$(var.ProductVersion)" Manufacturer="Eternalist" InstallerVersion="200" Scope="perUser">
      <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
      <Icon Id="Alacritty1337Ico" SourceFile=".\alacritty\windows\alacritty.ico" />
      <WixVariable Id="WixUILicenseRtf" Value=".\alacritty\windows\wix\license.rtf" />
      <Property Id="ARPPRODUCTICON" Value="Alacritty1337Ico" />
      <MediaTemplate EmbedCab="yes" />
      <ui:WixUI Id="WixUI_Minimal" />

      <Feature Id="ProductFeature" Title="alacritty-1337" Level="1">
         <ComponentRef Id="AlacrittyExe" />
         <ComponentRef Id="AlacrittyShortcut" />
         <ComponentRef Id="ModifyPathEnv" />
         <ComponentRef Id="ContextMenu" />
         <ComponentRef Id="ContextMenuFolder" />
      </Feature>

      <DirectoryRef Id="Alacritty1337InstallFolder">
         <Component Id="AlacrittyExe">
            <File Id="AlacrittyExeFile" Source=".\target\release\alacritty.exe" Name="alacritty.exe" KeyPath="yes" />
         </Component>
      </DirectoryRef>

      <DirectoryRef Id="Alacritty1337ProgramMenu">
         <Component Id="AlacrittyShortcut" Guid="e7419be2-2b12-4840-b9c1-e9db6baa4feb">
            <Shortcut Id="AlacrittyShortcutFile" Name="alacritty-1337" Description="alacritty but it doesn't suck" Target="[Alacritty1337InstallFolder]alacritty.exe" />
            <RemoveFolder Id="Alacritty1337ProgramMenu" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Eternalist\alacritty-1337" Name="installed" Type="integer" Value="1" KeyPath="yes" />
         </Component>
      </DirectoryRef>

      <DirectoryRef Id="Alacritty1337InstallFolder">
         <Component Id="ModifyPathEnv" Guid="688d8a38-e4b3-4547-892d-dbca732ff111" KeyPath="yes">
            <Environment Id="PathEnv" Value="[Alacritty1337InstallFolder]" Name="PATH" Permanent="no" Part="first" Action="set" System="no" />
         </Component>
      </DirectoryRef>

      <StandardDirectory Id="LocalAppDataFolder">
         <Directory Id="Alacritty1337Programs" Name="Programs">
            <Directory Id="Alacritty1337InstallFolder" Name="alacritty-1337" />
         </Directory>
      </StandardDirectory>
      <StandardDirectory Id="ProgramMenuFolder">
         <Directory Id="Alacritty1337ProgramMenu" Name="alacritty-1337" />
      </StandardDirectory>

      <Component Id="ContextMenu" Guid="e78baff6-35d6-47c9-bbac-4a2c666c14dd" Directory="TARGETDIR">
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open alacritty-1337 here\command">
            <RegistryValue Type="string" Value='[Alacritty1337InstallFolder]alacritty.exe --working-directory "%v"' KeyPath="yes" />
         </RegistryKey>
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open alacritty-1337 here">
            <RegistryValue Type="string" Name="Icon" Value="[Alacritty1337InstallFolder]alacritty.exe" />
         </RegistryKey>
      </Component>

      <Component Id="ContextMenuFolder" Guid="7c801219-ed2f-4a96-9d61-3045502f4726" Directory="TARGETDIR">
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Open alacritty-1337 here\command">
            <RegistryValue Type="string" Value='[Alacritty1337InstallFolder]alacritty.exe --working-directory "%v"' KeyPath="yes" />
         </RegistryKey>
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Open alacritty-1337 here">
            <RegistryValue Type="string" Name="Icon" Value="[Alacritty1337InstallFolder]alacritty.exe" />
         </RegistryKey>
      </Component>
   </Package>
</Wix>
