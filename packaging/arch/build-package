#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

packaging_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repository=$(cd -- "$packaging_dir/../.." && pwd)

if [[ ${1:-} == --source-ref ]]; then
    if [[ ${2:-} =~ ^commit=[0-9a-f]{40}$ ]]; then
        export ALACRITTY_SOURCE_REF=$2
        shift 2
    else
        printf '%s\n' '--source-ref requires commit=<40 lowercase hexadecimal digits>' >&2
        exit 64
    fi
fi

if [[ -z ${CARGO_TARGET_DIR:-} ]]; then
    target_root=$(cargo metadata --manifest-path "$repository/Cargo.toml" \
        --no-deps --format-version 1 \
        | sed -E 's/.*"target_directory":"([^"]+)".*/\1/')
    export CARGO_TARGET_DIR="$target_root/alacritty-1337-package"
fi

cd -- "$packaging_dir"
makepkg --config "$packaging_dir/makepkg.conf" --clean --cleanbuild --force "$@"

mapfile -t packages < <(makepkg --config "$packaging_dir/makepkg.conf" --packagelist)
if [[ ${#packages[@]} -ne 1 || ! -f ${packages[0]} ]]; then
    printf '%s\n' 'expected exactly one completed package' >&2
    exit 1
fi

manifest=$(pacman -Qlp -- "${packages[0]}")
metadata=$(pacman -Qip -- "${packages[0]}")
if ! grep -Eq '^Version[[:space:]]*: 1\.0\.0-1$' <<< "$metadata"; then
    printf '%s\n' 'package metadata does not report version 1.0.0-1' >&2
    exit 1
fi
for path in \
    'alacritty-1337 /usr/bin/alacritty' \
    'alacritty-1337 /usr/share/applications/alacritty-1337.desktop' \
    'alacritty-1337 /usr/share/metainfo/moe.eternalist.alacritty-1337.metainfo.xml' \
    'alacritty-1337 /usr/share/pixmaps/alacritty-1337.svg'; do
    if ! grep -Fxq -- "$path" <<< "$manifest"; then
        printf 'package is missing %s\n' "${path#* }" >&2
        exit 1
    fi
done
if grep -Eq '/(Alacritty\.desktop|Alacritty\.svg|org\.alacritty\.)' <<< "$manifest"; then
    printf '%s\n' 'package retained a stale upstream integration identifier' >&2
    exit 1
fi

printf 'built and inspected %s\n' "${packages[0]}"
